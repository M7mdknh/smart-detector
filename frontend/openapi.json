{
  "components": {
    "schemas": {
      "Actor": {
        "enum": [
          "SYSTEM",
          "HUMAN"
        ],
        "title": "Actor",
        "type": "string"
      },
      "Gas": {
        "enum": [
          "CO2"
        ],
        "title": "Gas",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IncidentAction": {
        "enum": [
          "ACKNOWLEDGE",
          "INVESTIGATE",
          "RESOLVE",
          "REOPEN",
          "COMMENT"
        ],
        "title": "IncidentAction",
        "type": "string"
      },
      "IncidentActionRequest": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/IncidentAction"
          },
          "actor": {
            "$ref": "#/components/schemas/Actor",
            "default": "HUMAN"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "action",
          "expected_version"
        ],
        "title": "IncidentActionRequest",
        "type": "object"
      },
      "ReadingQuality": {
        "enum": [
          "GOOD",
          "IMPUTED",
          "LATE",
          "STUCK",
          "NOISY",
          "MISSING",
          "FAULT"
        ],
        "title": "ReadingQuality",
        "type": "string"
      },
      "ReadingSource": {
        "enum": [
          "SIMULATOR",
          "REPLAY",
          "DEVICE"
        ],
        "title": "ReadingSource",
        "type": "string"
      },
      "SensorHistoryResponse": {
        "properties": {
          "gas": {
            "$ref": "#/components/schemas/Gas"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/SensorReadingOut"
            },
            "title": "Readings",
            "type": "array"
          },
          "zone_id": {
            "title": "Zone Id",
            "type": "string"
          }
        },
        "required": [
          "zone_id",
          "gas",
          "readings"
        ],
        "title": "SensorHistoryResponse",
        "type": "object"
      },
      "SensorReadingIn": {
        "additionalProperties": false,
        "description": "Public ingestion contract. Used identically by the simulator, replay, and future devices.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "event_time": {
            "format": "date-time",
            "title": "Event Time",
            "type": "string"
          },
          "fault_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault Code"
          },
          "gas": {
            "$ref": "#/components/schemas/Gas"
          },
          "quality": {
            "$ref": "#/components/schemas/ReadingQuality",
            "default": "GOOD"
          },
          "reading_id": {
            "format": "uuid",
            "title": "Reading Id",
            "type": "string"
          },
          "scenario_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Scenario Id",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sensor_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Sensor Id",
            "type": "string"
          },
          "sequence_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sequence Number"
          },
          "source": {
            "$ref": "#/components/schemas/ReadingSource"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "value": {
            "title": "Value",
            "type": "number"
          },
          "zone_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Zone Id",
            "type": "string"
          }
        },
        "required": [
          "reading_id",
          "sensor_id",
          "zone_id",
          "scenario_id",
          "gas",
          "value",
          "unit",
          "event_time",
          "source"
        ],
        "title": "SensorReadingIn",
        "type": "object"
      },
      "SensorReadingOut": {
        "additionalProperties": false,
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "event_time": {
            "format": "date-time",
            "title": "Event Time",
            "type": "string"
          },
          "fault_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault Code"
          },
          "gas": {
            "$ref": "#/components/schemas/Gas"
          },
          "ingested_at": {
            "format": "date-time",
            "title": "Ingested At",
            "type": "string"
          },
          "quality": {
            "$ref": "#/components/schemas/ReadingQuality",
            "default": "GOOD"
          },
          "reading_id": {
            "format": "uuid",
            "title": "Reading Id",
            "type": "string"
          },
          "scenario_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Scenario Id",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sensor_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Sensor Id",
            "type": "string"
          },
          "sequence_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sequence Number"
          },
          "source": {
            "$ref": "#/components/schemas/ReadingSource"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "value": {
            "title": "Value",
            "type": "number"
          },
          "zone_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Zone Id",
            "type": "string"
          }
        },
        "required": [
          "reading_id",
          "sensor_id",
          "zone_id",
          "scenario_id",
          "gas",
          "value",
          "unit",
          "event_time",
          "source",
          "ingested_at"
        ],
        "title": "SensorReadingOut",
        "type": "object"
      },
      "SimulationCommand": {
        "properties": {
          "command": {
            "title": "Command",
            "type": "string"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_state_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected State Version"
          },
          "payload": {
            "default": {},
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "command_id",
          "command"
        ],
        "title": "SimulationCommand",
        "type": "object"
      },
      "Unit": {
        "enum": [
          "ppm"
        ],
        "title": "Unit",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
