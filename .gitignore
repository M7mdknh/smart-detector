# Downloaded/extracted training datasets and browser automation profiles --
# reproducibly fetched by make train-vision / e2e, never committed.
models/training/data/
models/training/datasets/
datasets/
external-data/
*.zip
frontend/.playwright/
frontend/tests/.auth/

# Generated model artifacts are added deliberately when required.
# All bundled artifacts are small and reproducible, and needed for `make demo`
# to run in non-fallback mode (leak classifier, PPE detector, GRU residual
# forecast + its preprocessor) -- see docs/README.md §6/§7. The superseded
# ppe-yolo11n-v1.0.pt is also kept tracked: models/registry.json's
# "previous_version" entry and docs/FINAL_METRICS.md's v1.0->v1.1 comparison
# reference it by checksum, so silently dropping it from the submission would
# make that documented comparison unreproducible.
models/artifacts/*
!models/artifacts/.gitkeep
!models/artifacts/leak-classifier-xgb.json
!models/artifacts/ppe-yolo11n.pt
!models/artifacts/ppe-yolo11n-v1.0.pt
!models/artifacts/forecast-gru.pt
!models/artifacts/forecast-gru-scaler.json
!models/artifacts/forecast-gru-feature-schema.json

# Ultralytics' own per-epoch training run directory (weight snapshots, plots) --
# large and fully reproducible via `make train-vision`; only the aggregated JSON
# reports under models/evaluation/ are kept.
models/evaluation/vision_training_runs/

# Ultralytics also writes its own validation-run plots/images here by default
# (backend/runs/detect/val/*, or repo-root runs/detect/val/* depending on the
# invoking shell's cwd) whenever model.val()/evaluate_vision_model.py runs --
# reproducible, not referenced by any doc, not part of the intended repo
# structure (CLAUDE.md).
backend/runs/
/runs/

# Raw per-image audit output (backend/scripts/vision_data/audit_vision_data.py):
# ~80MB of per-file JSON records for every image in the v1.2 candidate dataset --
# reproducible via `make audit-vision-data`, and the actionable summary is
# already captured in the small contact_sheets/ PNGs kept alongside it and in
# models/evaluation/vision_v1.2_leakage_check.json / _subset_selection.json.
models/evaluation/vision_v1.2_data_audit/audit_report.json

# OS and editor files
.DS_Store
.idea/
.vscode/
.project-git/

# Raw user-supplied-footage staging area: kept local-only until each clip's
# provenance/license is confirmed and (if cleared) copied into
# demo-assets/interview_sources/ under its own documented filename -- see
# demo-assets/INTERVIEW_VIDEO_SOURCES.md. The staging copy is never itself
# the canonical source, so it is never committed even after clearing.
demo-assets/user-input/
demo-assets/incoming_footage/
